#!/bin/sh
#
# pre-commit: refresh README.md, then lint and type-check the staged Python
# files of the nina-planner project.
#
# Everything this hook can fix, it fixes and re-stages for you:
#   - README.md is regenerated by scripts/update_readme.py and re-staged.
#   - `ruff format` + `ruff check --fix` run over the staged .py files under
#     .opencode/local/mcps/nina_planner (the directory whose pyproject.toml
#     holds the ruff and mypy options), and whatever they changed is
#     re-staged.
# It only refuses the commit when a fix is impossible:
#   - mypy type errors in a staged package file,
#   - a failing scripts/update_readme.py, or ruff violations with no fix,
#   - a missing toolchain (build it with: make install_uv).
#
# Tests are ruff-checked but not type-checked: CI doesn't type-check them
# either (it runs `mypy nina_planner`), and they still carry ~1200
# pre-existing annotation errors.
#
# Staged .py files outside that project (scripts/, .agents/) are left
# alone — no ruff/mypy options apply to them here; `make lint` still runs
# ruff over the whole repo when you want that.
#
# Bypass everything with: git commit --no-verify

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

proj=.opencode/local/mcps/nina_planner
venv=$proj/.venv

# die "first line" "second line" ... — print each line, then abort the commit.
die() {
    echo "" >&2
    for msg in "$@"; do
        echo "pre-commit: $msg" >&2
    done
    echo "pre-commit: commit aborted (bypass: git commit --no-verify)." >&2
    exit 1
}

# ---------------------------------------------------------------------------
# 1. README.md is generated: scripts/update_readme.py quotes other files
#    verbatim inside it, so editing those without refreshing leaves the
#    README documenting something that no longer exists on disk.
# ---------------------------------------------------------------------------

if ! command -v python3 >/dev/null 2>&1; then
    die "python3 not found; cannot refresh README.md." \
        "install python3, otherwise README.md will go stale unnoticed."
fi

# The script only rewrites the fenced excerpts it owns, so compare README
# before/after: if the refresh actually changed it, stage it and carry on —
# no second round-trip through the index for you. An edit of your own that
# the generator does not own stays exactly where you left it.
readme_before=$(git hash-object -- README.md 2>/dev/null || true)

if ! python3 scripts/update_readme.py; then
    die "scripts/update_readme.py failed." \
        "fix the script before committing."
fi

if [ "$(git hash-object -- README.md 2>/dev/null || true)" != "$readme_before" ]; then
    git add README.md
    echo "pre-commit: README.md was stale; regenerated and re-staged." >&2
fi

# ---------------------------------------------------------------------------
# 2. Staged Python files inside the project.
# ---------------------------------------------------------------------------

# File names are newline separated from here on, so names with spaces stay
# whole when $staged / $fixed are expanded unquoted (as ruff arguments).
IFS='
'

staged=
other=
for f in $(git diff --cached --name-only -- '*.py'); do
    case "$f" in
        "$proj"/*.py)
            # A deleted file is still listed by git diff; it has nothing to lint.
            # Newline-joined: with IFS as above, leading/duplicate newlines
            # collapse, so the list stays free of stray leading spaces.
            if [ -f "$f" ]; then staged="${staged}
$f"; fi
            ;;
        *)
            if [ -f "$f" ]; then other="${other}
$f"; fi
            ;;
    esac
done

if [ -n "$other" ]; then
    echo "pre-commit: skipped, outside the linted project ($proj):" >&2
    for f in $other; do
        echo "  $f" >&2
    done
fi

if [ -z "$staged" ]; then
    echo "pre-commit: README in sync; no staged project Python files to lint." >&2
    exit 0
fi

ruff=$repo_root/$venv/bin/ruff
mypy=$repo_root/$venv/bin/mypy

if [ ! -x "$ruff" ] || [ ! -x "$mypy" ]; then
    die "$venv/bin is missing ruff and/or mypy." \
        "build the project venv first: make install_uv"
fi

# --- 2a. ruff: format, then autofix the lint rules --------------------------

# Snapshot the worktree first, so only what ruff itself changed gets
# re-staged — any other edit you had lying around in these files stays
# unstaged where you left it.
snap=$(mktemp)
trap 'rm -f "$snap"' EXIT

for f in $staged; do
    printf '%s  %s\n' "$(git hash-object -- "$f")" "$f" >>"$snap"
done

# Order matters: format first (so check sees canonical line breaks and can't
# trip E501 on something the formatter would have split), then autofix, then
# format once more — an autofix like dropping an unused import can leave the
# blank-line layout behind that only the formatter collapses.
if ! "$ruff" format -- $staged; then
    die "ruff format failed (see output above)."
fi

if ! "$ruff" check --fix -- $staged; then
    die "ruff check found violations it cannot fix (see output above)."
fi

if ! "$ruff" format -- $staged; then
    die "ruff format failed (see output above)."
fi

fixed=
for f in $staged; do
    if ! grep -q -x -F "$(git hash-object -- "$f")  $f" "$snap"; then
        fixed="${fixed}
$f"
    fi
done

if [ -n "$fixed" ]; then
    git add -- $fixed
    echo "pre-commit: ruff auto-fixed and re-staged:" >&2
    for f in $fixed; do
        echo "  $f" >&2
    done
fi

# --- 2b. mypy: one run per staged file -------------------------------------

# mypy has to run from the project dir — that is where pyproject.toml, and
# so its options, live — with VIRTUAL_ENV set, because the config points
# python_executable at $VIRTUAL_ENV/bin/python.
failed=
skipped=0

for f in $staged; do
    case "$f" in
        "$proj"/tests/*)
            skipped=$((skipped + 1))
            continue
            ;;
    esac

    rel=${f#"$proj"/}
    if ! (cd "$proj" && VIRTUAL_ENV="$repo_root/$venv" "$mypy" "$rel"); then
        failed="${failed}
$f"
    fi
done

if [ "$skipped" -gt 0 ]; then
    echo "pre-commit: mypy skipped $skipped test file(s) — tests are not type-checked." >&2
fi

if [ -n "$failed" ]; then
    die "mypy reported type errors in:" $failed
fi

echo "pre-commit: README in sync, ruff clean, mypy clean." >&2
exit 0
