{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "./nina-plugin.ts",
      {
        // "intervalCheck": 10,
        // "ninaEndpoint": "192.168.0.24:1888",
        "agentHistory": "/tmp/nina-agent.json",
        "pluginLogs": "/tmp/nina-plugins.log"
      }
    ]
  ],
  "mcp": {
    "nina-planner": {
      "type": "local",
      "environment": {
        // "NINA_ENDPOINT": "192.168.0.24:1888",
        // "NINA_DRIVE_MOUNT": "/mnt/c"
      },
      "command": [
        "bash", 
        "-c", 
        "uv run -m nina_planner 2>> /tmp/nina-planner.log"
      ]
    }
  }
}
