{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [ 
    [ "./nina-plugin.ts", 
      { 
        // "ninaEndpoint": "127.0.0.1:1888",
        // "intervalCheckMinutes": 10,
        // "disabled": true,
        "pluginLogs": "/tmp/nina-plugin-debug.log"
      } 
    ]
  ],
  "mcp": {
    "nina-planner": {
      "type": "local",
      "environment": {
        // "NINA_ENDPOINT": "127.0.0.1:1888",
        // "NINA_DRIVE_MOUNT": "/mnt/c",
        "NINA_PLANNER_LOG": "/tmp/nina-planner-debug.log"
      },
      "command": [
       	"uv", 
        "--directory",
        ".",
        "run",
        "-m",
        "nina_planner"
      ]
    }
  }
}
